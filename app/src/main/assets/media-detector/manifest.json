{
  "manifest_version": 2,
  "name": "Universal Media Detector",
  "version": "1.0",
  "description": "Detects media resources and player URLs for Universal Browser downloads.",
  "browser_specific_settings": {"gecko": {"id": "media-detector@universalbrowser.coeric"}},
  "permissions": ["webRequest", "webRequestBlocking", "cookies", "<all_urls>", "nativeMessaging", "nativeMessagingFromContent"],
  "background": {"scripts": ["background.js"]},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}]
}
