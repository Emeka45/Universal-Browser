{
  "manifest_version": 2,
  "name": "Universal Media Detector",
  "version": "1.0.0",
  "description": "Detects playable, non-DRM media on pages and reports downloadable sources to Universal Browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "media-detector@universalbrowser"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["media-detector.js"],
      "run_at": "document_idle"
    }
  ]
}
